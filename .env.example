# 차세대 풍멜이 로컬 설정 예시. 실제 비밀값은 이 파일에 넣지 않습니다.
PUNGMAIL_DATABASE_PATH=data/pungmail.db
PUNGMAIL_EVIDENCE_PATH=runtime/evidence
PUNGMAIL_LOG_PATH=runtime/logs/pungmail.jsonl
PUNGMAIL_PREFECT_HOME=runtime/prefect
PUNGMAIL_PREFECT_API_URL=http://127.0.0.1:4200/api

# 기존 운영 프로젝트는 읽기 전용으로 참조합니다.
PUNGMAIL_LEGACY_PROJECT_PATH=C:/Users/ASUS/Documents/New project
PUNGMAIL_GMAIL_CREDENTIALS_PATH=C:/Users/ASUS/Documents/New project/credentials.json
PUNGMAIL_GMAIL_TOKEN_PATH=C:/Users/ASUS/Documents/New project/token.json
PUNGMAIL_GMAIL_ENABLED=true

PUNGMAIL_MAIL_CHECK_INTERVAL_SECONDS=60
PUNGMAIL_MAX_MESSAGES_PER_RUN=25
PUNGMAIL_HISTORY_PAGE_SIZE=100
PUNGMAIL_HISTORY_RECOVERY_DAYS=7
PUNGMAIL_MAX_ATTACHMENT_BYTES=26214400
PUNGMAIL_MAX_ARCHIVE_ENTRIES=100
PUNGMAIL_MAX_ARCHIVE_ENTRY_BYTES=20971520
PUNGMAIL_MAX_ARCHIVE_TOTAL_BYTES=83886080
PUNGMAIL_TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe
PUNGMAIL_OCR_LANGUAGES=kor+eng
PUNGMAIL_LOG_LEVEL=INFO
